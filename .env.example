# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=AIzaSyDLiDkYRBwK0Su2Q67YYhtdV7DOzLW33jw

# Primary Administrator & Initial Proxmox Setup
# These can be customized during Proxmox installation or modified in the web Admin Pane.
PANTRYO_ADMIN_NAME="Alex Johnson"
PANTRYO_ADMIN_USERNAME="alex"
PANTRYO_ADMIN_PASSWORD="PantryoSecure2026!"
PANTRYO_ADMIN_AVATAR="/avatars/chef-cat.svg"

# Database Encryption: 256-bit AES-GCM / SQLCipher key
# Auto-generated during Proxmox install (or 64 hex characters)
DB_ENCRYPTION_KEY="27f76ac5ffba8d8497dec5374687f317132443edc16e8c624c175e25edf48ea1"

# DATABASE_URL: PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://pantryo_admin:pantryo_secure_pass@localhost:5432/pantryo?schema=public"

# APP_URL: The URL where this applet is hosted.
# For production via Cloudflare Tunnel, use your domain: https://pantryo.yknet.org
APP_URL="https://pantryo.yknet.org"

# EXPO_PUBLIC_API_URL: Target API endpoint for Expo React Native mobile client
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1/inventory"

# CLOUDFLARE_TUNNEL_TOKEN: Cloudflare Zero Trust tunnel token for remote exposure
CLOUDFLARE_TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"
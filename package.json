{
  "name": "pantryo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "audit:check": "npm audit",
    "audit:strict": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "update:deps": "node scripts/auto-update-dependencies.js",
    "postinstall": "npm rebuild better-sqlite3-multiple-ciphers || true"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "better-sqlite3-multiple-ciphers": "^13.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.82.0",
    "motion": "^14.14.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "argparse": "^2.0.1",
    "body-parser": ">=2.4.0",
    "fast-uri": ">=3.1.9",
    "glob": ">=14.0.6",
    "minimatch": ">=11.0.9",
    "qs": ">=6.17.1",
    "serialize-javascript": ">=7.1.4"
  }
}
